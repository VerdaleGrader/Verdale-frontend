{
  "name": "verdale-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run contracts:check && npm run legal:check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "contracts:sync": "scripts/contracts.sh sync ../Verdale-core-service/contracts && npm run contracts:generate",
    "contracts:generate": "openapi-typescript contracts/core-public.openapi.yaml -o lib/contracts/core-public.gen.ts && prettier --write lib/contracts",
    "contracts:check": "scripts/contracts.sh verify && node scripts/contracts-check.mjs",
    "legal:generate": "node scripts/legal-bundle.mjs",
    "legal:check": "node scripts/legal-bundle.mjs --check",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@monaco-editor/react": "4.7.0",
    "@opennextjs/cloudflare": "1.20.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "katex": "0.16.22",
    "lucide-react": "0.562.0",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "openapi-fetch": "0.15.0",
    "pdfjs-dist": "6.3.289",
    "radix-ui": "1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.7",
    "@types/katex": "0.16.7",
    "@types/node": "22.19.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.8",
    "jsdom": "27.2.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.7.1",
    "tailwindcss": "4.1.17",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.0.15",
    "wrangler": "4.148.0"
  }
}
