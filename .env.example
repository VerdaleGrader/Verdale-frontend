# Copy to .env.local. Server-side only: the browser never sees Core's URL,
# it calls relative paths that Next.js proxies (next.config.ts).
CORE_API_URL=http://localhost:8080
# Optional: the public bucket's own domain, if Core's PUBLIC_ASSET_BASE_URL is set.
# Statement pictures are shown only from /api/v1/assets/ and from this address.
NEXT_PUBLIC_ASSET_BASE_URL=

